{
  "realm": "demo",
  "enabled": true,
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "pgfs-reader",
      "name": "pg_featureserv Reader",
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "reader-secret",
      "attributes": {
        "tls.client.certificate.bound.access.tokens": "false"
      },
      "protocolMappers": [
        {
          "name": "hardcoded-role-reader",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "role",
            "claim.value": "reader",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "pgfs-power",
      "name": "pg_featureserv Power",
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "power-secret",
      "attributes": {
        "tls.client.certificate.bound.access.tokens": "false"
      },
      "protocolMappers": [
        {
          "name": "hardcoded-role-power",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "role",
            "claim.value": "power",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ]
}

